# Positive Mantra Consulting — /pmc/ folder
# Live path: https://ultramindlabs.com/pmc/
# Requires Apache mod_rewrite
#
# IMPORTANT:
# Links like /about are handled by the DOMAIN ROOT, not this file.
# Also upload domain-root.htaccess one level ABOVE /pmc/ (see that file).

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /pmc/

  # /pmc/index.html → /pmc/
  RewriteCond %{THE_REQUEST} \s/pmc/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://ultramindlabs.com/pmc/ [R=301,L]

  # /pmc/page.html → /pmc/page
  RewriteCond %{THE_REQUEST} \s/pmc/([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ https://ultramindlabs.com/pmc/%1 [R=301,L]

  # Pass through real files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /pmc/about → about.html (internal)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

Options -Indexes
