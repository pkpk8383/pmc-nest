<!-- ============================================================ HEADER -->
<header class="pmc-header">
  <nav class="navbar navbar-expand-lg pmc-navbar pmc-nav" aria-label="Primary navigation">
    <div class="pmc-container d-flex flex-wrap align-items-center">
      <a class="navbar-brand" href="/">
        <img src="/images/pmc-logo-nav.svg" alt="Positive Mantra Consulting" width="94" height="43">
      </a>

      <div class="pmc-nav__tools">
        <div class="pmc-search" data-search>
          <button type="button" class="nav-link pmc-nav-search" data-search-open aria-expanded="false" aria-controls="pmcNavSearchPanel">
            <img src="/images/icons/search.svg" width="44" height="44" alt="" aria-hidden="true">
            <span>Search</span>
          </button>
          <form class="pmc-search__panel" id="pmcNavSearchPanel" data-search-panel hidden role="search">
            <label class="visually-hidden" for="pmcNavSearchInput">Search the site</label>
            <input
              class="pmc-search__input"
              id="pmcNavSearchInput"
              data-search-input
              type="search"
              name="q"
              placeholder="Search"
              autocomplete="off"
            >
          </form>
        </div>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#pmcMainNav" aria-controls="pmcMainNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
      </div>

      <div class="collapse navbar-collapse" id="pmcMainNav">
        <ul class="navbar-nav align-items-lg-center">
          <li class="nav-item dropdown pmc-mega-dropdown">
            <a
              class="nav-link dropdown-toggle {{#if (eq activeNav 'about')}}active{{/if}}"
              href="/about"
              aria-expanded="false"
              aria-haspopup="true"
            >
              About us
              <img class="nav-caret" src="/images/icons/chevron-down.svg" alt="" aria-hidden="true">
            </a>
            <div class="dropdown-menu pmc-mega pmc-mega--about" role="menu" aria-label="About us menu">
              <div class="pmc-mega__panel">
                <div class="pmc-mega__intro">
                  <span class="pmc-mega__accent" aria-hidden="true"></span>
                  <p class="pmc-mega__title">About Us</p>
                  <p class="pmc-mega__desc">Discover the people, purpose, and principles behind PMC</p>
                </div>
                <div class="pmc-mega__links">
                  <a class="pmc-mega__link" href="/about#values" role="menuitem">
                    <span>Our Values &amp; Purpose</span>
                    <img class="pmc-mega__arrow" src="/images/icons/chevron-double.svg" alt="" aria-hidden="true">
                  </a>
                  <a class="pmc-mega__link" href="/about#leadership" role="menuitem">
                    <span>Leadership</span>
                    <img class="pmc-mega__arrow" src="/images/icons/chevron-double.svg" alt="" aria-hidden="true">
                  </a>
                </div>
                <div class="pmc-mega__media">
                  <img src="/images/about-us.png" alt="Hands holding a compass against a mountain sunset">
                </div>
              </div>
            </div>
          </li>
          <li class="nav-item dropdown pmc-mega-dropdown">
            <a
              class="nav-link dropdown-toggle {{#if (eq activeNav 'services')}}active{{/if}}"
              href="#"
              role="button"
              aria-expanded="false"
              aria-haspopup="true"
            >
              Services
              <img class="nav-caret" src="/images/icons/chevron-down.svg" alt="" aria-hidden="true">
            </a>
            <div class="dropdown-menu pmc-mega pmc-mega--services" role="menu" aria-label="Our Services menu">
              <div class="pmc-mega__panel">
                <div class="pmc-mega__intro">
                  <span class="pmc-mega__accent" aria-hidden="true"></span>
                  <p class="pmc-mega__title">Our Services</p>
                  <p class="pmc-mega__desc">Three integrated services. One mission: transforming ideas into impact.</p>
                </div>
                <div class="pmc-mega__links">
                  <a class="pmc-mega__link" href="/consulting" role="menuitem">
                    <span>Consulting</span>
                    <img class="pmc-mega__arrow" src="/images/icons/chevron-double.svg" alt="" aria-hidden="true">
                  </a>
                  <a class="pmc-mega__link" href="/capacity-building" role="menuitem">
                    <span>Capacity Building and Training</span>
                    <img class="pmc-mega__arrow" src="/images/icons/chevron-double.svg" alt="" aria-hidden="true">
                  </a>
                  <a class="pmc-mega__link" href="/technology" role="menuitem">
                    <span>Technology</span>
                    <img class="pmc-mega__arrow" src="/images/icons/chevron-double.svg" alt="" aria-hidden="true">
                  </a>
                </div>
                <div class="pmc-mega__media">
                  <img src="/images/our-services.png" alt="Team collaborating over documents and charts">
                </div>
              </div>
            </div>
          </li>
          <li class="nav-item"><a class="nav-link" href="/#sectors">Sectors</a></li>
          <li class="nav-item"><a class="nav-link" href="/#impact">Impact Created</a></li>
          <li class="nav-item"><a class="nav-link {{#if (eq activeNav 'career')}}active{{/if}}" href="/career">Career</a></li>
          <li class="nav-item"><a class="nav-link {{#if (eq activeNav 'contact')}}active{{/if}}" href="/contact">Contact us</a></li>
        </ul>
      </div>
    </div>
  </nav>
</header>
