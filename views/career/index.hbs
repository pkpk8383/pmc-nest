            <button type="button" class="pmc-team__dot is-active" aria-label="Go to team slide 1" aria-selected="true" data-team-dot></button>
            <button type="button" class="pmc-team__dot" aria-label="Go to team slide 2" aria-selected="false" data-team-dot></button>
            <button type="button" class="pmc-team__dot" aria-label="Go to team slide 3" aria-selected="false" data-team-dot></button>
            <button type="button" class="pmc-team__dot" aria-label="Go to team slide 4" aria-selected="false" data-team-dot></button>
            <button type="button" class="pmc-team__dot" aria-label="Go to team slide 5" aria-selected="false" data-team-dot></button>
          </div>
          <div class="pmc-carousel-nav pmc-team__nav">
            <button type="button" class="pmc-carousel-btn" aria-label="Previous team members" data-team-prev>
              <svg width="16" height="14" viewBox="0 0 16 14" fill="none" aria-hidden="true"><path d="M16 7H1M6 1L1 7l5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="pmc-carousel-btn pmc-carousel-btn--ink" aria-label="Next team members" data-team-next>
              <svg width="16" height="14" viewBox="0 0 16 14" fill="none" aria-hidden="true"><path d="M0 7h15M10 1l5 6-5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ============================================== APPLICATION MODAL -->
  <div class="modal fade pmc-modal" id="applyModal" tabindex="-1" aria-labelledby="applyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header border-0">
          <h2 class="modal-title h5" id="applyModalLabel">Apply to Positive Mantra Consulting</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form class="pmc-form" action="#" method="post" novalidate data-validate>
            <div class="pmc-form__grid">
              <div class="pmc-field">
                <label class="pmc-field__label" for="apply-name">Name<span class="pmc-field__req">*</span></label>
                <input class="pmc-input" type="text" id="apply-name" name="name" placeholder="Full name" required>
                <span class="pmc-field__error">Please enter your name.</span>
              </div>
              <div class="pmc-field">
                <label class="pmc-field__label" for="apply-email">Email<span class="pmc-field__req">*</span></label>
                <input class="pmc-input" type="email" id="apply-email" name="email" placeholder="Write your email ID" required>
                <span class="pmc-field__error">Please enter a valid email address.</span>
              </div>
              <div class="pmc-field">
                <label class="pmc-field__label" for="apply-phone">Phone Number<span class="pmc-field__req">*</span></label>
                <input class="pmc-input" type="tel" id="apply-phone" name="phone" placeholder="Phone number" pattern="[0-9+\-\s]{7,15}" required>
                <span class="pmc-field__error">Please enter a valid phone number.</span>
              </div>
              <div class="pmc-field">
                <label class="pmc-field__label" for="apply-role">Role<span class="pmc-field__req">*</span></label>
                <input class="pmc-input" type="text" id="apply-role" name="role" placeholder="Role you're applying for" required>
                <span class="pmc-field__error">Please enter the role.</span>
              </div>
              <div class="pmc-field pmc-field--full">
                <label class="pmc-field__label" for="apply-resume">Resume (PDF/DOC)<span class="pmc-field__req">*</span></label>
                <input class="pmc-input" type="file" id="apply-resume" name="resume" accept=".pdf,.doc,.docx" required>
                <span class="pmc-field__error">Please attach your resume.</span>
              </div>
              <div class="pmc-field pmc-field--full">
                <label class="pmc-field__label" for="apply-message">Message</label>
                <textarea class="pmc-textarea" id="apply-message" name="message" placeholder="Tell us a little about yourself"></textarea>
              </div>
            </div>
            <div class="pmc-form__actions">
              <button type="submit" class="pmc-btn pmc-btn--primary">
                Submit application
                <img class="pmc-btn__arrow" src="/images/icons/arrow-right-white.svg" alt="" aria-hidden="true">
              </button>
              <p class="pmc-form__success" data-form-success hidden role="status">Thank you — your application has been received.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
