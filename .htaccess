# PMC NestJS — Laragon (pmc-nest.test)
# Apache DocumentRoot is the project root; Nest runs on Node (default :3000).
# mod_proxy is often disabled in Laragon, so requests go through index.php.

Options -Indexes
DirectoryIndex index.php

# Block sensitive paths
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.env|^\.git|composer\.(json|lock)|package(-lock)?\.json|tsconfig.*\.json|nest-cli\.json)">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Deny direct web access to app internals
  RewriteRule ^(src|dist|node_modules|views|\.cursor|\.git)(/|$) - [F,L]

  # Serve static assets from /public without hitting Node
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
  RewriteRule ^(.*)$ public/$1 [L]

  # Front controller → PHP reverse proxy → NestJS
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>
